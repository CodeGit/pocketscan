# Long-lived platform pieces. These must survive the per-session cluster being
# destroyed (the cluster lives in a separate root), so they are never part of it.

# Container images. Manifests pin images by digest, so there is deliberately no cleanup
# policy: deleting an "old" image could break a pinned manifest.
resource "google_artifact_registry_repository" "images" {
  repository_id = "pocketscan"
  location      = var.region
  format        = "DOCKER"
  description   = "pocketscan container images (api, web, pipeline)"

  depends_on = [google_project_service.enabled]
}

# Structures and pipeline output. Private; the API serves files to the browser.
resource "google_storage_bucket" "data" {
  name     = "${var.project_id}-data" # bucket names are global, so prefix with the project
  location = var.region

  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"

  # Everything here can be regenerated by re-running the pipeline.
  lifecycle_rule {
    condition {
      age = 30
    }
    action {
      type = "Delete"
    }
  }

  depends_on = [google_project_service.enabled]
}

# Jobs waiting to be analysed. The API publishes; Argo Events subscribes.
resource "google_pubsub_topic" "jobs" {
  name                       = "pocketscan-jobs"
  message_retention_duration = "86400s"

  depends_on = [google_project_service.enabled]
}

resource "google_pubsub_subscription" "jobs_argo" {
  name  = "pocketscan-jobs-argo"
  topic = google_pubsub_topic.jobs.id

  ack_deadline_seconds = 60

  # The default deletes a subscription after 31 days without activity, which would
  # silently break the queue between demo sessions. An empty ttl means never expire.
  expiration_policy {
    ttl = ""
  }
}
