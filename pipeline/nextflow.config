// Defaults for a local run. Override on the command line, e.g. --outdir gs://bucket/results
params {
    job_id          = null          // required: the job these proteins belong to
    accessions      = null          // required: comma-separated UniProt accessions
    outdir          = 'results'

    // fpocket. These are passed to the tool AND recorded as the run's parameters,
    // so the analysis_run cache key reflects what was really used.
    fpocket_min_alpha_sphere_radius = 3.4
    fpocket_max_alpha_sphere_radius = 6.2
    fpocket_min_alpha_spheres       = 15
    // Names the binary that produced the result; part of the cache key.
    tool_version    = '4.0+4bb0d84'
}

process {
    errorStrategy = 'terminate'     // overridden per process below
    // Local profile: tools come from PATH (run through `uv run nextflow ...`).
    // A container profile, with images pinned by digest, is added with the Dockerfile.
}

// Keep every protein's failure local: report it, don't stop the batch.
trace.overwrite    = true
report.overwrite   = true
timeline.overwrite = true
dag.overwrite      = true
